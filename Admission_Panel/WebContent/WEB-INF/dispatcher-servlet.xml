 <!-- DAO -->
    <bean id="qrAttendanceDao"
          class="in.ac.dei.edrp.admissionsystem.QrAttendence.QrAttendanceDaoImpl">
        <property name="sqlMapClient" ref="sqlMapClient"/>
    </bean>

    <!-- Controller  -->
    <bean name="/qrAttendance/*.htm"
          class="in.ac.dei.edrp.admissionsystem.QrAttendence.QrAttendanceController">
        <property name="qrAttendanceDao" ref="qrAttendanceDao"/>
        
    </bean> 
    
    
   


    



 
<bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver" 
