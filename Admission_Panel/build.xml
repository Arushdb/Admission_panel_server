<project name="Admission_Panel" default="build-war" basedir=".">

	 <!-- Set properties -->
	  <property name="src.dir" value="src"/>
		
	  <property name="build.dir" value="build"/>
	  <property name="web.dir" value="WebContent"/>
	  <property name="dist.dir" value="dist"/>
	  <property name="war.name" value="admission_panel_server.war"/>

	  <!-- Define classpath -->
	  <path id="compile.classpath">
	 
	    <fileset dir="WebContent/WEB-INF/lib">
	      <include name="**/*.jar"/>
	    </fileset>
		
	  </path>

	  <!-- Clean previous builds -->
	  <target name="clean">
	  	 
	    <delete dir="${build.dir}"/>
	    <delete dir="${dist.dir}"/>
	  </target>

	  <!-- Compile Java source files -->
	  <target name="compile">
	    <mkdir dir="${build.dir}/WEB-INF/classes"/>
	    <javac srcdir="${src.dir}" destdir="${build.dir}/WEB-INF/classes" includeantruntime="false">
	      <classpath refid="compile.classpath"/>
	    </javac>
	  </target>

	  <!-- Copy static web files and JARs -->
	  <target name="copy-web">
	    <!-- Copy WebContent to build dir -->
	    <copy todir="${build.dir}">
	      <fileset dir="${web.dir}"/>
	    </copy>
	  	 <copy todir="${build.dir}/WEB-INF/classes/">
	  		      <fileset dir="${src.dir}"/>
	  		    </copy>

	    <!-- Copy JARs to WEB-INF/lib for runtime -->
	    <mkdir dir="${build.dir}/WEB-INF/lib"/>
	    <copy todir="${build.dir}/WEB-INF/lib">
	      <fileset dir="WebContent/WEB-INF/lib">
	        <include name="**/*.jar"/>
	      </fileset>
	    </copy>
	  </target>

	  <!-- Build WAR file -->
	  <target name="build-war" depends="clean,compile,copy-web">
	    <mkdir dir="${dist.dir}"/>
	    <war destfile="${dist.dir}/${war.name}" webxml="${web.dir}/WEB-INF/web.xml">
	      <fileset dir="${build.dir}"/>
	    </war>
	    <echo>WAR created: ${dist.dir}/${war.name}</echo>
	  </target>
</project>
